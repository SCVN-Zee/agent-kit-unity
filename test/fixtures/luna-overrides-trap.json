{
 "creativeName": "Tét-ad",
 "unity": {
  "scenes": ["Assets/Game/Scenes/Main.unity"],
  "disabledScenes": [],
  "disableAntiAliasing": true,
  "enableRealtimeShadows": false
 },
 "assets": {
  "rules": {
   "texture": {
    "default": { "maxWidth": 256, "maxHeight": 256, "compression": "quantQuality", "quality": 65 },
    "overrides": [
     { "name": "Assets/Game/Sprites/Hero.png", "maxWidth": 512, "maxHeight": 512, "compression": "none", "quality": 65, "halfPrecision": true }
    ]
   },
   "sound": { "default": { "bitrate": 64 }, "overrides": [ { "name": "Assets/Game/Audio/sfx.wav", "bitrate": 96 } ] },
   "font": { "default": { "data": { "textureWidth": 256, "textureHeight": 256 } } },
   "meshes": { "default": { "halfPrecision": true, "useSimplification": false, "simplificationPercentage": 30 } },
   "animations": { "default": { "halfPrecision": true, "stripCurves": false } }
  }
 }
}
