{
  "name": "agent-kit-unity",
  "version": "0.2.0-beta.1",
  "description": "MCP-agnostic Unity conventions and reference-feature kit for project-scoped OMP, Pi, Codex, and Claude Code installs. One shared source supplies Unity skills, rules, and optional Supercent/Luna tiers without registering MCP servers or global hooks.",
  "scripts": {
    "test": "npm run test:scripts && node --test test/*.test.cjs",
    "test:scripts": "node --test scripts/tests/*.test.cjs",
    "lint": "npm run lint:loc && npm run lint:frontmatter && npm run lint:docs-counts",
    "lint:loc": "node scripts/lint-loc.cjs",
    "lint:frontmatter": "node scripts/lint-frontmatter.cjs",
    "lint:docs-counts": "node scripts/lint-docs-counts.cjs"
  },
  "bin": {
    "aku-ship-kit": "./scripts/ship-kit.cjs",
    "aku-ship-omp": "./scripts/ship-omp.cjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SCVN-Zee/agent-kit-unity.git"
  },
  "keywords": [
    "unity",
    "unity-mcp",
    "playable-ads",
    "luna",
    "ai-agents",
    "oh-my-pi"
  ],
  "author": "Duy Nguyen",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/SCVN-Zee/agent-kit-unity/issues"
  },
  "homepage": "https://github.com/SCVN-Zee/agent-kit-unity#readme",
  "files": [
    "kit/",
    "scripts/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
