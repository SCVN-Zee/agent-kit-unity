#!/bin/sh
set -eu

REPOSITORY='@@REPOSITORY@@'
TAG='@@TAG@@'
ARCHIVE='@@ARCHIVE@@'
EXPECTED_SHA256='@@SHA256@@'
BASE_URL="${AKU_RELEASE_BASE_URL:-https://github.com/$REPOSITORY/releases/download/$TAG}"

for command in curl tar node; do
  if ! command -v "$command" >/dev/null 2>&1; then
    echo "install.sh: required command not found: $command" >&2
    exit 1
  fi
done

NODE_MAJOR="$(node -p "Number(process.versions.node.split('.')[0])")"
if [ "$NODE_MAJOR" -lt 18 ]; then
  echo "install.sh: Node 18+ is required (found $(node --version))" >&2
  exit 1
fi

TMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/agent-kit-unity.XXXXXX")"
trap 'rm -rf "$TMP_DIR"' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

curl -fsSL --retry 3 --retry-connrefused "$BASE_URL/$ARCHIVE" -o "$TMP_DIR/$ARCHIVE"
ACTUAL_SHA256="$(node -e "const fs=require('fs'),c=require('crypto');process.stdout.write(c.createHash('sha256').update(fs.readFileSync(process.argv[1])).digest('hex'))" "$TMP_DIR/$ARCHIVE")"
if [ "$ACTUAL_SHA256" != "$EXPECTED_SHA256" ]; then
  echo "install.sh: checksum mismatch for $ARCHIVE" >&2
  exit 1
fi

mkdir "$TMP_DIR/unpacked"
tar -xzf "$TMP_DIR/$ARCHIVE" -C "$TMP_DIR/unpacked"
node "$TMP_DIR/unpacked/package/scripts/ship-omp.cjs" "$@"
